table _Medidas
	lineageTag: f4ec8296-a452-4408-a59e-f797607e3fa2

	/// Valor bruto vendido (ERP), antes de descontos.
	measure Faturamento = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Receita bruta de vendas")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 01 Receita
		lineageTag: 6b69c1ec-29e9-4e2f-94e8-4c529ebf88ac

	/// Negativo = desconto líquido concedido.
	measure 'Descontos e Acréscimos' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Descontos e acréscimos")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 01 Receita
		lineageTag: 50738721-d7db-4420-967d-c2dd65bcd96e

	/// Itens que não são mercadoria (ex.: renegociação de crediário).
	measure 'Outras Receitas' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Outras receitas")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 01 Receita
		lineageTag: 057179f4-65be-4fe0-83ab-c739066536ca

	/// Receita bruta + descontos/acréscimos + outras receitas.
	measure 'Receita Líquida' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[natureza] = "Receita")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 01 Receita
		lineageTag: dc195c21-f933-4fd0-afdc-f56bbb3c13f9

	/// Peças vendidas.
	measure 'Qtd Vendida' = SUM('financeiro vw_fato_principal'[qtd])
		formatString: #,##0
		displayFolder: 01 Receita
		lineageTag: 7199fbce-bc13-47d9-bb1d-a66e25242cd1

	measure 'Preço Médio por Peça' = DIVIDE([Faturamento], [Qtd Vendida])
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 01 Receita
		lineageTag: 3be40de3-456b-4ef3-bc12-475fe6dc3512

	/// Desconto líquido sobre a receita bruta.
	measure 'Desconto %' = DIVIDE(-[Descontos e Acréscimos], [Faturamento])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Receita
		lineageTag: 51a29bed-6af4-4d0e-9ae6-b44c65ce9d11

	/// Custo da mercadoria vendida (ERP), negativo.
	measure CMV = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[natureza] = "Custo")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 02 Custo e Margem
		lineageTag: 38b9f515-19b9-4e34-b9d1-66b6fa069e6e

	measure 'Lucro Bruto' = [Receita Líquida] + [CMV]
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 02 Custo e Margem
		lineageTag: 27140b3a-57aa-467c-a0ae-e6995ff7f5e6

	measure 'Margem Bruta %' = DIVIDE([Lucro Bruto], [Receita Líquida])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Custo e Margem
		lineageTag: a91fa2eb-84c3-462a-a195-da365f93d4c6

	/// Preço / custo.
	measure Markup = DIVIDE([Receita Líquida], -[CMV])
		formatString: 0.00"x"
		displayFolder: 02 Custo e Margem
		lineageTag: c05c712e-3cf1-4293-ac00-7772744eebf7

	/// Saídas do caixa que entram na DRE (negativo).
	measure 'Despesas Operacionais' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[natureza] = "Despesa")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: 9226d961-1175-4e39-a124-ff1e4330b2de

	measure 'Despesas com Pessoal' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Despesas com pessoal")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: 4d87812b-fc88-44c1-b0db-a03638af5c46

	measure Pró-labore = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Pró-labore")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: 98182335-c7c8-4602-a1db-3b0f50a051ff

	measure Impostos = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Impostos")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: 24638351-39a8-40b2-8950-7d0160dc5f30

	measure 'Despesas de Ocupação' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Despesas de ocupação")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: 277e3eae-5d1c-4aa2-949b-c388a67353e7

	measure 'Despesas Logísticas' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Despesas logísticas")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: c3f10ed5-57a4-43b2-ad33-e6fe998b9470

	measure 'Despesas Administrativas' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Despesas administrativas")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: de3fb103-4e3c-42f3-9c0a-ea3ee3d1e668

	measure 'Despesas Financeiras' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Despesas financeiras")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: 768b0f07-bc7d-48cb-8b3b-5806f037055a

	measure 'Despesas a Classificar' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "A classificar")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 03 Despesas
		lineageTag: b92e502e-785c-4934-90a9-60c55b250b6f

	measure 'Despesas % Receita' = DIVIDE(-[Despesas Operacionais], [Receita Líquida])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Despesas
		lineageTag: 0f79bc5a-d901-4766-b0fb-d962783d90ea

	/// Lucro bruto - despesas operacionais. Só fecha com todas as lojas carregadas.
	measure Resultado = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[entra_no_dre] = TRUE())
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 04 Resultado
		lineageTag: 15640c9a-a9ab-4b94-8532-54b5d9efc6b7

	measure 'Margem Líquida %' = DIVIDE([Resultado], [Receita Líquida])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Resultado
		lineageTag: 1d8fa2cc-10bc-4caf-b9ee-c2eb54c6f78e

	measure Recebimentos = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[natureza] = "Recebimento", 'financeiro vw_fato_principal'[entra_no_fluxo] = TRUE())
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: ac37680e-b7c4-47e8-a3c4-8c3c8ef32e26

	/// Todas as saídas do caixa (negativo), dentro e fora da DRE.
	measure 'Saídas de Caixa' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[origem] = "Caixa diário", 'financeiro vw_fato_principal'[natureza] <> "Recebimento", 'financeiro vw_fato_principal'[entra_no_fluxo] = TRUE())
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: ebaa92aa-b1c6-4fdf-b1b6-33c65a9e018d

	measure 'Fluxo de Caixa Líquido' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[entra_no_fluxo] = TRUE())
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: 6128b276-b4d6-46a4-bf22-38a53646e84d

	/// Soma do fluxo desde o início dos dados (variação de caixa, não saldo bancário).
	measure 'Fluxo de Caixa Acumulado' = VAR _ate = MAX(d_Calendario[Date]) RETURN CALCULATE([Fluxo de Caixa Líquido], FILTER(ALL(d_Calendario), d_Calendario[Date] <= _ate))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: 3b40efeb-2a87-4369-a068-682206d9e344

	/// Saída do caixa fora da DRE.
	measure 'Compras de Mercadoria (Caixa)' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Compras de mercadoria")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: 96752e29-0003-4e07-b3b4-b29d78c13330

	/// Saída do caixa fora da DRE.
	measure 'Amortização de Empréstimos' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Financeiro - amortização")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: 7b13b247-728f-4e9d-8637-545c984a5972

	/// Saída do caixa fora da DRE.
	measure Investimentos = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Investimentos")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: 58444be3-b388-4faa-b31d-ff04852cd48f

	/// Saída do caixa fora da DRE.
	measure 'Retiradas dos Sócios' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Não operacional - sócios")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: 51a23173-0253-4ebe-a497-87afaa4d6143

	/// Saída do caixa fora da DRE.
	measure 'Transferências entre Lojas' = CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[grupo_dre] = "Transferências")
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 05 Caixa
		lineageTag: ce5ff37b-2cc9-4a62-8ea3-1414101f7eb3

	measure 'Receita Líquida Mês Anterior' = CALCULATE([Receita Líquida], DATEADD(d_Calendario[Date], -1, MONTH))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 06 Comparativos
		lineageTag: 5a142ed2-8d9e-4833-96a9-b69fce1a609a

	measure 'Receita Líquida Var % Mês' = DIVIDE([Receita Líquida] - [Receita Líquida Mês Anterior], ABS([Receita Líquida Mês Anterior]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 78d8e0be-2ad3-4dc3-a1a4-78d732049336

	measure 'Receita Líquida Ano Anterior' = CALCULATE([Receita Líquida], SAMEPERIODLASTYEAR(d_Calendario[Date]))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 06 Comparativos
		lineageTag: 79c6a35a-ef97-4464-89b0-62b744b85253

	measure 'Receita Líquida Var % Ano' = DIVIDE([Receita Líquida] - [Receita Líquida Ano Anterior], ABS([Receita Líquida Ano Anterior]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 21fd03fe-8363-4abd-a499-1e88d2621482

	measure 'Receita Líquida Acumulado no Ano' = TOTALYTD([Receita Líquida], d_Calendario[Date])
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 06 Comparativos
		lineageTag: 32ed54ad-5ce3-422c-a38d-ad428a2f8b50

	measure 'Resultado Mês Anterior' = CALCULATE([Resultado], DATEADD(d_Calendario[Date], -1, MONTH))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 06 Comparativos
		lineageTag: 60fa3672-597b-430f-8aec-f5b4a6333f47

	measure 'Resultado Var % Mês' = DIVIDE([Resultado] - [Resultado Mês Anterior], ABS([Resultado Mês Anterior]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 544fc340-8d97-4d9c-b662-3f2b8215067e

	measure 'Resultado Ano Anterior' = CALCULATE([Resultado], SAMEPERIODLASTYEAR(d_Calendario[Date]))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 06 Comparativos
		lineageTag: 06368fcd-3d85-487a-99cf-4ab6c46a7ae4

	measure 'Resultado Var % Ano' = DIVIDE([Resultado] - [Resultado Ano Anterior], ABS([Resultado Ano Anterior]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 22244e86-ea8c-4cec-939b-f55af3da9d7e

	measure 'Resultado Acumulado no Ano' = TOTALYTD([Resultado], d_Calendario[Date])
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 06 Comparativos
		lineageTag: cf2c88d0-840c-4091-90b9-e375c14e6c2c

	measure 'Margem Bruta % Ano Anterior' = CALCULATE([Margem Bruta %], SAMEPERIODLASTYEAR(d_Calendario[Date]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Comparativos
		lineageTag: 19a36fd9-7e6b-45bf-a95e-f3de9fe9a581

	/// Último dia do período filtrado que tem venda carregada. Base dos acumulados do painel.
	measure 'Data de Referência' = VAR _ult = CALCULATE(MAX('financeiro vw_fato_principal'[data]), REMOVEFILTERS('financeiro vw_fato_principal'), 'financeiro vw_fato_principal'[origem] = "ERP vendas") RETURN MAXX(FILTER(VALUES(d_Calendario[Date]), d_Calendario[Date] <= _ult), d_Calendario[Date])
		formatString: dd/mm/yyyy
		displayFolder: 07 Painel Resultados
		lineageTag: da0db207-f614-4fb0-9ee9-d1f6febec216

	/// Receita líquida de 1º de janeiro até a data de referência.
	measure 'Vendas Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Receita Líquida], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 53ac7ac8-4655-4adc-8618-68da75161fb2

	measure 'Vendas Acum Ano Anterior' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Receita Líquida], DATESBETWEEN(d_Calendario[Date], EDATE(DATE(YEAR(_ref), 1, 1), -12), EDATE(_ref, -12)), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 800a6786-6044-47b3-9361-8309b1b2f781

	measure 'Vendas Acum Texto' = VAR _a = [Vendas Acum Ano Anterior] VAR _v = DIVIDE([Vendas Acum] - _a, _a) RETURN IF(ISBLANK(_a), "sem dados do ano anterior", FORMAT(_v, "+0.0%;-0.0%") & " vs mesmo período do ano anterior")
		displayFolder: 07 Painel Resultados
		lineageTag: 7c16ae46-5353-48a9-adb4-85060ce929a1

	measure 'Lucro Bruto Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Lucro Bruto], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 59af4d43-bf5b-4725-9026-cfde39947f35

	/// Margem bruta acumulada: o que sobra da venda após o custo dos produtos.
	measure 'Ganho na Venda Acum %' = DIVIDE([Lucro Bruto Acum], [Vendas Acum])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Painel Resultados
		lineageTag: 11e97c97-2e1d-4e46-9a85-678bc2bd9eea

	measure 'Ganho na Venda Acum % Ano Anterior' = DIVIDE(VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Lucro Bruto], DATESBETWEEN(d_Calendario[Date], EDATE(DATE(YEAR(_ref), 1, 1), -12), EDATE(_ref, -12)), REMOVEFILTERS(d_Calendario))), [Vendas Acum Ano Anterior])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Painel Resultados
		lineageTag: 08f2ec06-d2b8-4cef-b32b-06073083a00c

	measure 'Ganho na Venda Texto' = VAR _a = [Ganho na Venda Acum % Ano Anterior] RETURN IF(ISBLANK(_a), "sobra após pagar os produtos", FORMAT(([Ganho na Venda Acum %] - _a) * 100, "+0.0;-0.0") & " p.p. vs ano anterior")
		displayFolder: 07 Painel Resultados
		lineageTag: 59f064bd-c017-4f2e-8446-c11b8afbb841

	/// Custo das trocas e devoluções (o ERP não informa quebra/furto).
	measure 'Perdas Acum' = -VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE(CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[conta] = "CMV - trocas e devoluções"), DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: e8d2eaad-32f6-4fab-9182-b8a08d2b4334

	measure 'Perdas Texto' = FORMAT(DIVIDE([Perdas Acum], [Vendas Acum]), "0.0%") & " das vendas · trocas e devoluções"
		displayFolder: 07 Painel Resultados
		lineageTag: 58297f51-1678-4686-a2fa-2375b4fe0676

	/// Despesas operacionais do caixa (positivo).
	measure 'Despesas da Loja Acum' = -VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Despesas Operacionais], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 54374257-7105-4838-bce4-f6b5ec78e849

	measure 'Despesas da Loja Texto' = FORMAT(DIVIDE([Despesas da Loja Acum], [Vendas Acum]), "0.0%") & " das vendas · pessoal, ocupação e contas"
		displayFolder: 07 Painel Resultados
		lineageTag: 17830b78-8786-4786-a94a-807bf8736d66

	measure 'Lucro Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Resultado], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 733a3a97-d359-4810-941f-0af1327277c2

	measure 'Margem de Lucro Acum %' = DIVIDE([Lucro Acum], [Vendas Acum])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Painel Resultados
		lineageTag: 0356bac2-430f-4644-9866-f4861fdc1525

	measure 'Lucro Texto' = FORMAT([Margem de Lucro Acum %], "0.0%") & " de margem sobre as vendas"
		displayFolder: 07 Painel Resultados
		lineageTag: 3bc42914-5b14-42cd-ba7d-bb46d8aedb7b

	/// Placeholder até termos a fonte de estoque.
	measure Estoque = "Sem dados"
		displayFolder: 07 Painel Resultados
		lineageTag: faea3dd0-449b-4adb-863e-27e2c2916aa0

	measure 'Estoque Texto' = "aguardando a base de estoque"
		displayFolder: 07 Painel Resultados
		lineageTag: 515c403a-14b8-4de5-b149-0e029f72076b

	/// Valor de cada linha da DRE no acumulado (cascata).
	measure 'DRE Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Resultado], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 7276d617-bb3f-4eb5-9b33-200ba8b3d282

	/// Últimos 12 meses até a última venda, ignorando o filtro de período.
	measure 'Vendas 12M' = VAR _ult = CALCULATE(MAX('financeiro vw_fato_principal'[data]), REMOVEFILTERS('financeiro vw_fato_principal'), 'financeiro vw_fato_principal'[origem] = "ERP vendas") VAR _ini = EOMONTH(_ult, -12) + 1 RETURN IF(MAX(d_Calendario[Date]) >= _ini && MIN(d_Calendario[Date]) <= _ult, [Receita Líquida])
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: 3d6a83e7-89b5-49d1-b43f-04f7a0490c0f

	/// Últimos 12 meses até a última venda, ignorando o filtro de período.
	measure 'Lucro 12M' = VAR _ult = CALCULATE(MAX('financeiro vw_fato_principal'[data]), REMOVEFILTERS('financeiro vw_fato_principal'), 'financeiro vw_fato_principal'[origem] = "ERP vendas") VAR _ini = EOMONTH(_ult, -12) + 1 RETURN IF(MAX(d_Calendario[Date]) >= _ini && MIN(d_Calendario[Date]) <= _ult, [Resultado])
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 07 Painel Resultados
		lineageTag: c53c5b11-31b3-4d23-939e-209aec32dc42

	measure 'Qtd Vendida Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Qtd Vendida], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: #,##0
		displayFolder: 08 Vendas Analítico
		lineageTag: ffd99610-f106-4bdc-b45d-e1dd4e4c6e7a

	measure 'Receita Bruta Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Faturamento], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 08 Vendas Analítico
		lineageTag: 2b9b5948-b854-4c1e-bd58-068c29a0f059

	/// Negativo = desconto concedido; positivo = acréscimo (ex.: juros do crediário).
	measure 'Descontos Acum' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Descontos e Acréscimos], DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 08 Vendas Analítico
		lineageTag: 4c76a21e-eeba-452e-a811-add2601833b5

	/// Custo dos produtos vendidos (positivo), sem trocas/devoluções.
	measure 'CMV Produtos Acum' = -VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE(CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[conta] = "CMV"), DATESBETWEEN(d_Calendario[Date], DATE(YEAR(_ref), 1, 1), _ref), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 08 Vendas Analítico
		lineageTag: 67090f19-68f1-407e-be9c-ed87fd9090f2

	measure 'Lucro Bruto Produtos Acum' = [Vendas Acum] - [CMV Produtos Acum]
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 08 Vendas Analítico
		lineageTag: ba3eba00-57af-43e3-90f2-93521ef64218

	measure 'Margem Bruta Produtos Acum %' = DIVIDE([Lucro Bruto Produtos Acum], [Vendas Acum])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Vendas Analítico
		lineageTag: 287dc824-c00f-47ff-977f-1bb8253d2463

	measure 'Preço Médio Acum' = DIVIDE([Receita Bruta Acum], [Qtd Vendida Acum])
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 08 Vendas Analítico
		lineageTag: 9bb6226e-20b4-43d0-ac5a-54c1b4fe120b

	/// Peso da linha nas vendas do que está filtrado.
	measure 'Participação nas Vendas %' = DIVIDE([Vendas Acum], CALCULATE([Vendas Acum], ALLSELECTED('financeiro vw_fato_principal'[grupo_produto], 'financeiro vw_fato_principal'[categoria_produto], 'financeiro vw_fato_principal'[descricao])))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Vendas Analítico
		lineageTag: 8f73207c-5a27-4a89-957c-fbf24f46c21f

	measure 'Vendas Var % Ano Anterior' = VAR _a = [Vendas Acum Ano Anterior] RETURN IF(NOT ISBLANK(_a), DIVIDE([Vendas Acum] - _a, _a))
		formatString: "▲ "0.0%;"▼ "0.0%;0.0%
		displayFolder: 08 Vendas Analítico
		lineageTag: c8a642e2-5141-45fe-98a5-ba157fcdc1eb

	measure 'Última Venda' = CALCULATE(MAX('financeiro vw_fato_principal'[data]), 'financeiro vw_fato_principal'[natureza] = "Receita")
		formatString: dd/mm/yyyy
		displayFolder: 08 Vendas Analítico
		lineageTag: 205f60f2-a0ba-441c-8649-4fea02a78901

	measure 'Perdas Acum Ano Anterior' = -VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE(CALCULATE(SUM('financeiro vw_fato_principal'[valor]), 'financeiro vw_fato_principal'[conta] = "CMV - trocas e devoluções"), DATESBETWEEN(d_Calendario[Date], EDATE(DATE(YEAR(_ref), 1, 1), -12), EDATE(_ref, -12)), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 09 Cards HTML
		lineageTag: 3606f5a1-791d-4d13-bf10-66d7cfdc7fe2

	measure 'Perdas % Vendas' = DIVIDE([Perdas Acum], [Vendas Acum])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09 Cards HTML
		lineageTag: 7002d2df-b7ab-47e1-bb97-07684bb1ab4e

	measure 'Perdas % Vendas Ano Anterior' = DIVIDE([Perdas Acum Ano Anterior], [Vendas Acum Ano Anterior])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09 Cards HTML
		lineageTag: 222928af-9959-48dc-8be5-4187076be005

	measure 'Despesas da Loja Acum Ano Anterior' = -VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Despesas Operacionais], DATESBETWEEN(d_Calendario[Date], EDATE(DATE(YEAR(_ref), 1, 1), -12), EDATE(_ref, -12)), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 09 Cards HTML
		lineageTag: f1d0f9fc-4470-4d75-bccb-ae02f136acce

	measure 'Lucro Acum Ano Anterior' = VAR _ref = [Data de Referência] RETURN IF(NOT ISBLANK(_ref), CALCULATE([Resultado], DATESBETWEEN(d_Calendario[Date], EDATE(DATE(YEAR(_ref), 1, 1), -12), EDATE(_ref, -12)), REMOVEFILTERS(d_Calendario)))
		formatString: \R$ #,##0;-\R$ #,##0;\R$ #,##0
		displayFolder: 09 Cards HTML
		lineageTag: 420e890a-f361-4e67-9007-568c82343e16

	/// HTML do card (use no visual HTML Content).
	measure 'Card Vendas' =
			VAR _ref = [Data de Referência]
			VAR _valor = VAR _x = [Vendas Acum] VAR _s = IF(_x < 0, "-", "") VAR _y = ABS(_x) RETURN IF(ISBLANK(_x), "—", _s & "R$ " & IF(_y >= 1000000, FORMAT(_y / 1000000, "#,0.00") & " mi", IF(_y >= 10000, FORMAT(_y / 1000, "#,0") & " mil", IF(_y >= 1000, FORMAT(_y / 1000, "#,0.0") & " mil", FORMAT(_y, "#,0")))))
			VAR _a = [Vendas Acum]
			VAR _b = [Vendas Acum Ano Anterior]
			VAR _tem = NOT ISBLANK(_a) && NOT ISBLANK(_b) && _b <> 0
			VAR _d = IF(_tem, DIVIDE(_a - _b, ABS(_b)))
			VAR _bom = _d >= 0
			VAR _cor = IF(NOT _tem, "#4B5563", IF(_bom, "#1F47B3", "#A3400E"))
			VAR _fundo = IF(NOT _tem, "#EEF0F4", IF(_bom, "#EDF1FC", "#FCEFE7"))
			VAR _periodo = "jan–" & FORMAT(EDATE(_ref, -12), "mmm/yy")
			VAR _selo = IF(_tem, IF(_d >= 0, "&#8599; ", "&#8600; ") & FORMAT(ABS(_d), "0.0%"), "sem comparação")
			VAR _texto = IF(_tem, IF(_d >= 0, "a mais que ", "a menos que ") & _periodo, "sem dados do ano anterior")
			RETURN
			    IF(NOT ISBLANK(_ref),
			        "<div style='font-family:Manrope,""Segoe UI"",sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px;padding:2px 4px;box-sizing:border-box;width:100%'>"
			        & "<div style='font-size:28px;font-weight:800;letter-spacing:-0.02em;color:#111827;line-height:1.15;margin-bottom:2px'>" & _valor & "</div>"
			        & "<div style='display:flex;flex-direction:column;align-items:center;gap:6px'>"
			        & IF(_tem, "<span style='display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;color:" & _cor & ";background:" & _fundo & ";padding:3px 8px;border-radius:999px;white-space:nowrap'>" & _selo & "</span>", "")
			        & "<span style='font-size:12px;color:#6B7280;line-height:1.4'>" & _texto & "</span>"
			        & "</div></div>"
			    )
		displayFolder: 09 Cards HTML
		lineageTag: a38dd3aa-c0e1-41f7-b5cc-82eb1c5db891

	/// HTML do card (use no visual HTML Content).
	measure 'Card Ganho na Venda' =
			VAR _ref = [Data de Referência]
			VAR _valor = FORMAT([Ganho na Venda Acum %], "0.0%")
			VAR _a = [Ganho na Venda Acum %]
			VAR _b = [Ganho na Venda Acum % Ano Anterior]
			VAR _tem = NOT ISBLANK(_a) && NOT ISBLANK(_b) && _b <> 0
			VAR _d = IF(_tem, (_a - _b) * 100)
			VAR _bom = _d >= 0
			VAR _cor = IF(NOT _tem, "#4B5563", IF(_bom, "#1F47B3", "#A3400E"))
			VAR _fundo = IF(NOT _tem, "#EEF0F4", IF(_bom, "#EDF1FC", "#FCEFE7"))
			VAR _periodo = "jan–" & FORMAT(EDATE(_ref, -12), "mmm/yy")
			VAR _selo = IF(_tem, IF(_d >= 0, "&#8599; ", "&#8600; ") & FORMAT(ABS(_d), "0.0") & IF(ABS(_d) < 2, " ponto", " pontos"), "sem comparação")
			VAR _texto = IF(_tem, "vs " & _periodo, "sobra após pagar os produtos")
			RETURN
			    IF(NOT ISBLANK(_ref),
			        "<div style='font-family:Manrope,""Segoe UI"",sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px;padding:2px 4px;box-sizing:border-box;width:100%'>"
			        & "<div style='font-size:28px;font-weight:800;letter-spacing:-0.02em;color:#111827;line-height:1.15;margin-bottom:2px'>" & _valor & "</div>"
			        & "<div style='display:flex;flex-direction:column;align-items:center;gap:6px'>"
			        & IF(_tem, "<span style='display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;color:" & _cor & ";background:" & _fundo & ";padding:3px 8px;border-radius:999px;white-space:nowrap'>" & _selo & "</span>", "")
			        & "<span style='font-size:12px;color:#6B7280;line-height:1.4'>" & _texto & "</span>"
			        & "</div></div>"
			    )
		displayFolder: 09 Cards HTML
		lineageTag: bab5211b-b38b-4376-9402-b81fd796a927

	/// HTML do card (use no visual HTML Content).
	measure 'Card Perdas' =
			VAR _ref = [Data de Referência]
			VAR _valor = VAR _x = [Perdas Acum] VAR _s = IF(_x < 0, "-", "") VAR _y = ABS(_x) RETURN IF(ISBLANK(_x), "—", _s & "R$ " & IF(_y >= 1000000, FORMAT(_y / 1000000, "#,0.00") & " mi", IF(_y >= 10000, FORMAT(_y / 1000, "#,0") & " mil", IF(_y >= 1000, FORMAT(_y / 1000, "#,0.0") & " mil", FORMAT(_y, "#,0")))))
			VAR _a = [Perdas % Vendas]
			VAR _b = [Perdas % Vendas Ano Anterior]
			VAR _tem = NOT ISBLANK(_a) && NOT ISBLANK(_b) && _b <> 0
			VAR _d = IF(_tem, (_a - _b) * 100)
			VAR _bom = _d <= 0
			VAR _cor = IF(NOT _tem, "#4B5563", IF(_bom, "#1F47B3", "#A3400E"))
			VAR _fundo = IF(NOT _tem, "#EEF0F4", IF(_bom, "#EDF1FC", "#FCEFE7"))
			VAR _periodo = "jan–" & FORMAT(EDATE(_ref, -12), "mmm/yy")
			VAR _selo = IF(_tem, IF(_d >= 0, "&#8599; ", "&#8600; ") & FORMAT(ABS(_d), "0.0") & IF(ABS(_d) < 2, " ponto", " pontos"), "sem comparação")
			VAR _texto = IF(_tem, "vs " & _periodo, "trocas e devoluções")
			RETURN
			    IF(NOT ISBLANK(_ref),
			        "<div style='font-family:Manrope,""Segoe UI"",sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px;padding:2px 4px;box-sizing:border-box;width:100%'>"
			        & "<div style='font-size:28px;font-weight:800;letter-spacing:-0.02em;color:#111827;line-height:1.15;margin-bottom:2px'>" & _valor & "</div>"
			        & "<div style='display:flex;flex-direction:column;align-items:center;gap:6px'>"
			        & IF(_tem, "<span style='display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:700;color:" & _cor & ";background:" & _fundo & ";padding:3px 8px;border-radius:999px;white-space:nowrap'>" & _selo & "</span>", "")
			        & "<span style='font-size:12px;color:#6B7280;line-height:1.4'>" & _texto & "</span>"
			        & "</div></div>"
			    )
		displayFolder: 09 Cards HTML
		lineageTag: bffc3b01-e6c0-494d-a4c2-8deee83b5ad0

	/// HTML do card (use no visual HTML Content).
	measure 'Card Despesas' =
			VAR _ref = [Data de Referência]
			VAR _valor = VAR _x = [Despesas da Loja Acum] VAR _s = IF(_x < 0, "-", "") VAR _y = ABS(_x) RETURN IF(ISBLANK(_x), "—", _s & "R$ " & IF(_y >= 1000000, FORMAT(_y / 1000000, "#,0.00") & " mi", IF(_y >= 10000, FORMAT(_y / 1000, "#,0") & " mil", IF(_y >= 1000, FORMAT(_y / 1000, "#,0.0") & " mil", FORMAT(_y, "#,0")))))
