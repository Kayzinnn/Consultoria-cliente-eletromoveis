	/// HTML do card (use no visual HTML Content).
	measure 'Card Estoque' =
			VAR _ref = [Data de Referência]
			VAR _valor = "—"
			VAR _a = BLANK()
			VAR _b = BLANK()
			VAR _tem = NOT ISBLANK(_a) && NOT ISBLANK(_b) && _b <> 0
			VAR _d = IF(_tem, DIVIDE(_a - _b, ABS(_b)))
			VAR _bom = _d >= 0
